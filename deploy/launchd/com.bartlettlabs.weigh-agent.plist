<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.bartlettlabs.weigh-agent</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/kylebartlett/Library/Scripts/weigh/weigh-agent-launchd.sh</string>
	</array>
	<key>EnvironmentVariables</key>
